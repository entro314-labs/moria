# Where releases are published and how updates are signed; read by package_app.sh and release.sh.

# Releases are GitHub releases; Sparkle reads the latest one's appcast.xml.
GITHUB_REPO=entro314-labs/moria
# Public half of the update signing key. The private half is in the login keychain (account
# "moria", made with Sparkle's generate_keys); every update must be signed with it.
SPARKLE_PUBLIC_KEY=SX3feVZpvV/I9YM/dscHHWvkBpaPxZmBPAupPpJ8ltQ=
SPARKLE_KEY_ACCOUNT=moria
# Sparkle's release tools (generate_appcast); keep in step with the Sparkle package version.
SPARKLE_VERSION=2.10.0
SPARKLE_SHA256=c2bf58aa8387266ac179357b1415d6f2635f044da8be41042af32425dae6da0c  # pinned; update with SPARKLE_VERSION
